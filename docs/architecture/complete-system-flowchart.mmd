%% Financial Crime Risk Assessment Workbench - complete architecture and end-to-end workflow
%% Source of truth: backend/app (FastAPI, LangGraph, services, models), alembic/versions 0001-0022, frontend/src
%% Edge legend: blue = frontend REST request | slate = backend processing | purple = AI / LLM call
%%              green dotted = database read/write | orange = human action or decision | grey dashed = audit write | red = error / refusal
%% Node legend: dashed border = optional or supported-but-inactive component; red node = error / refusal path; "provisional" in a label = implemented on policy pending governance approval
flowchart TD

subgraph ACT["USERS AND REVIEWERS - role-based access (UserRole)"]
  direction LR
  U_BIZ(["Business User<br/>assessment owner"])
  U_FCRM(["FCRM Analyst"])
  U_MGR(["Assigned Manager<br/>or active delegate"])
  U_COM(["Committee Member<br/>incl. Committee Chair"])
  U_RO(["Auditor / Executive<br/>read-only"])
  U_ADM(["Admin / Policy Admin"])
end

subgraph FE["FRONTEND - React 19 + TypeScript + Vite SPA"]
  direction LR
  FE_LOGIN["LoginPage + AuthContext<br/>JWT kept in localStorage"]
  FE_CREATE["CreateAssessment<br/>manual form or document upload"]
  FE_WF["AssessmentWorkflow + StageTracker<br/>polls GET /api/processing-jobs/{id}"]
  FE_QUEUE["WorkQueue, Approvals,<br/>Dashboard pages"]
  FE_AUDIT["AuditHistory, DecisionPackage,<br/>Reports pages"]
  FE_HTTP["api/*.ts authFetch()<br/>REST + Authorization: Bearer JWT"]
end

subgraph BE["BACKEND - Python FastAPI"]
  subgraph GW["REST API layer, authentication and authorization"]
    API_MW["Middleware: SecurityHeaders, CORS,<br/>RequestTiming, AdminAudit,<br/>optional HTTPS redirect"]
    API_LOGIN["POST /api/auth/login<br/>bcrypt check, HS256 JWT issued"]
    API_AUTHZ{"JWT valid and role,<br/>object visibility and entity<br/>scope allowed?"}
    API_DENY["401 / 403 refused<br/>ACCESS_DENIED logged"]
    API_ROUTERS["Routers: assessments, workflow, approvals,<br/>controls, challenge-review, processing-jobs,<br/>audit-trail, reports, reassessment"]
  end
  subgraph SVC["Assessment services and business logic"]
    SVC_WF["Workflow state machine services/workflow.py<br/>TRANSITIONS role matrix, guards, SLA dates<br/>every status move uses transition()"]
    SVC_READY["Governance readiness evaluate()<br/>residual, comments, findings, sign-off,<br/>overrides, SoD conflicts"]
    SVC_JOBS["ProcessingJob service<br/>in-process ThreadPoolExecutor,<br/>progress stage log, retry"]
    SVC_SCORE["Deterministic risk engine<br/>likelihood x impact, weights, bands,<br/>escalation rules, residual grid"]
    SVC_ESC["Background escalation loop<br/>overdue assessments and action items"]
  end
  subgraph P1["1 - BUSINESS INTAKE"]
    I1["POST /api/assessments<br/>product, service, change type, business unit,<br/>countries, channels, transactions, vendors"]
    I1D["POST /analyze-document then<br/>/create-with-document<br/>AI pre-fills intake fields"]
    I2{"Submitting and all<br/>mandatory fields complete?"}
    I2X["422 Missing mandatory information<br/>or kept as Draft"]
    I3["Persist assessment, reference_id,<br/>intake snapshot, triage priority,<br/>routing queue"]
    I4["Status INTAKE<br/>workflow DRAFT to SUBMITTED<br/>POST /workflow/submit for drafts"]
  end
  subgraph P2["2 - EVIDENCE REVIEW"]
    E1["POST /advance-stage-async<br/>INTAKE to EVIDENCE_COLLECTION"]
    E1D{"Title, description<br/>and evidence present?"}
    E1X["400 Still a draft<br/>complete intake first"]
    E2["POST /{id}/documents<br/>DOCX, PDF, XLSX, TXT, CSV, ZIP<br/>type and size checks, text extraction"]
    E3["Encrypted file storage<br/>+ document embeddings"]
    E4["Structured business profile<br/>AssessmentIntelligence<br/>GET /evidence-gaps, /consistency-check"]
    E5{"Owner confirmed profile?<br/>POST /intelligence/confirm"}
    E5X["400 PROFILE_NOT_CONFIRMED<br/>workflow INTAKE_VALIDATION"]
    E6{"Expired documents<br/>acknowledged or excluded?"}
    E6X["Blocked: POST /documents/{id}/<br/>expiry-acknowledgement"]
    E7["Workflow EVIDENCE_REVIEW<br/>inputs ready for AI analysis"]
  end
end

subgraph AIW["3 - AI RISK IDENTIFICATION - LangGraph orchestration"]
  A0["POST /advance-stage-async<br/>EVIDENCE_COLLECTION to RISK_IDENTIFICATION<br/>or POST /analyze-async - pipeline roles"]
  A1["run_risk_assessment_workflow()<br/>AI metering context,<br/>optional Langfuse trace"]
  subgraph LG["LangGraph StateGraph - RiskAssessmentState"]
    LG0(("START"))
    LG1[["load_assessment"]]
    LG2[["gather_intelligence<br/>confirmed business profile"]]
    LG3[["identify_risks"]]
    LG4[["calculate_scores<br/>calculate_inherent_risk()<br/>skipped when unavailable"]]
    LG5[["persist_results<br/>versioned risk factors, score,<br/>analysis mode, audit event"]]
    LG9(("END"))
  end
  subgraph IR["identify_risks node internals"]
    R1["Prepare AI context: intake fields, usable<br/>current documents, evidence sources,<br/>similar cases via pgvector - Postgres only"]
    R2["identify_risk_factors() prompt<br/>10 canonical financial crime<br/>risk categories, JSON mode"]
    R3{"LLM call succeeded?<br/>retry on 408, 429, 5xx"}
    R4["Validate JSON, verify each quote<br/>verbatim against its source<br/>sets evidence_status per factor"]
    R5["Apply Stage 4 deterministic rules<br/>signals marked provisional"]
    R6{"Operational AI failure<br/>and rules fallback OK?"}
    R7["Mode rules_only<br/>deterministic RiskEngine,<br/>provisional, needs acknowledgement"]
    R8["Mode unavailable<br/>no rating written"]
  end
  subgraph LLMP["CONFIGURED LLM PROVIDER - app/ai/provider.py"]
    LLM1{{"OpenAI chat completions<br/>gpt-4.1-mini, LLM_PROVIDER=openai"}}
    LLM2{{"OpenAI embeddings<br/>text-embedding-3-small, 1536-d"}}
    LLM3{{"OpenRouter - supported alternative,<br/>not active in backend/.env"}}
  end
  METER["metered_post()<br/>all outbound AI calls"]
  A2["record_ai_run() to<br/>ai_evaluation_records - best effort"]
  A3{"Workflow raised<br/>an exception?"}
  A4["Rollback, HTTP 500 or job FAILED<br/>POST /processing-jobs/{id}/retry"]
  A5["Transition to RISK_IDENTIFICATION<br/>STAGE_ADVANCED audit,<br/>workflow RISK_ASSESSMENT_IN_PROGRESS"]
end


subgraph XAI["OTHER AI-ASSISTED STEPS - outside LangGraph, same provider via metered_post()"]
  X1["Document field extraction<br/>document_analysis/ai_extractor"]
  X2["Likelihood x impact suggestions<br/>POST /risk-factors/suggest-ratings"]
  X3["Control identification and<br/>control design assessment"]
  X4["Assessment draft narrative<br/>assessment_draft_generator"]
end

subgraph HRA["HUMAN REVIEW AND APPROVAL"]
  subgraph P4["4 - HUMAN RISK RATING - FCRM Analyst, Manager or Admin"]
    H1{"Result provisional<br/>rules_only?"}
    H2["POST /acknowledge-degraded<br/>or re-run risk identification"]
    H3["Analyst rates each applicable factor<br/>PATCH /risk-factors/{id}/rating<br/>add, exclude factors, edit indicators"]
    H4{"Rating equals<br/>AI suggestion?"}
    H5["Reason required<br/>ANALYST_OVERRIDE ledger entry"]
    H6{"All applicable<br/>factors rated?"}
    H7["INHERENT_RISK_ASSESSMENT<br/>inherent score and band frozen,<br/>optional documented override"]
    H8["CONTROL_ASSESSMENT<br/>AI-proposed controls per factor,<br/>analyst assesses controls"]
    H9{"Control outcome recorded<br/>and residual band determined?"}
    H10["RESIDUAL_RISK frozen<br/>inherent band x control rating grid<br/>recommended conditions, residual confirm"]
    H11["Advance to HUMAN_REVIEW<br/>AI draft narrative generated"]
  end
  subgraph P5["5 - FCRM REVIEW - workflow ANALYST_REVIEW"]
    F1["PATCH /fcrm-review<br/>justification and human severity<br/>reconciliation per risk result"]
    F2{"Human rating differs<br/>from calculated?"}
    F3["Justification mandatory<br/>FCRM_REVIEW override ledger entry"]
    F4["Review comments, challenge findings<br/>resolve or accept with reason"]
    F5["Independent challenge-review sign-off<br/>refused while HIGH or CRITICAL open"]
    F6{"More information<br/>needed?"}
    F7["POST /request-information<br/>status INFORMATION_REQUESTED"]
    F8["Owner POST /provide-information<br/>resumes previous status"]
    F9["Owner POST /submit-to-manager<br/>SUBMITTED_TO_MANAGER<br/>workflow CHALLENGE_REVIEW"]
  end
  subgraph P6["6 - MANAGER APPROVAL"]
    M1["Manager reviews assessment and FCRM review<br/>SoD: not own submission, Admin cannot<br/>substitute, delegation authority resolved"]
    M2{"POST /manager-decision"}
    M3{"Approval gates met?<br/>comments resolved, inherent final,<br/>committee readiness"}
    M3X["400 / 409 blockers returned"]
    M4["READY_FOR_COMMITTEE<br/>MANAGER_APPROVED"]
    M5["RETURNED_BY_MANAGER<br/>workflow AMENDMENT_REQUIRED<br/>sign-off superseded"]
    M6["MANAGER_REJECTED<br/>workflow REJECTED"]
  end
  subgraph P7["7 - COMMITTEE DECISION - applies to every risk level"]
    K1["POST /workflow/open-committee-review<br/>or first vote: COMMITTEE_REVIEW"]
    K2["POST /committee-votes<br/>one current vote per seat,<br/>append-only re-cast with reason"]
    K3{"POST /committee-decision"}
    K4{"Decision record complete and<br/>FINAL_DECISION readiness met?"}
    K4X["400 / 409 decision blocked"]
    K5["DEFERRED<br/>returns to committee review"]
  end
  subgraph P8["8 - FINAL DECISION"]
    FD1["Outcome stored on assessment<br/>APPROVED, APPROVED_WITH_CONDITIONS,<br/>REJECTED with rationale and decider"]
    FD2{"Approved?"}
    FD3["freeze_decision_record()<br/>JSON snapshot + checksum,<br/>decision lock"]
    FD4["Committee conditions become<br/>action items with owner, due date,<br/>closure approval"]
    FD5{"Open action items<br/>or conditions?"}
    FD6["POST /workflow/close<br/>status CLOSED"]
    FD7["POST /amend - Committee or Admin<br/>REMEDIATION, then re-enters<br/>Phase 1 INTAKE"]
    FD8["Reassessment triggers<br/>child assessment supersedes parent<br/>on approval"]
  end
end

subgraph DB["DATABASE - PostgreSQL on Neon + pgvector, SQLAlchemy 2, Alembic 0001 to 0022"]
  direction LR
  DB_CORE[("assessments, users,<br/>assessment_intelligence,<br/>intake_snapshots, assessment_documents")]
  DB_VEC[("document_embeddings<br/>pgvector")]
  DB_RISK[("risk_factors, risk_results,<br/>inherent / residual_risk_calculations,<br/>controls, processing_jobs")]
  DB_REV[("assessment_fcrm_reviews, comments,<br/>challenge_findings, signoffs,<br/>assessment_overrides")]
  DB_GOV[("committee_votes, committee_conditions,<br/>action_items, decision_records,<br/>approval_delegations, sod_exceptions")]
  DB_AUD[("audit_events, workflow_transitions,<br/>ai_usage_logs, ai_evaluation_records")]
  DB_FILES[("Encrypted upload files<br/>FILE_ENCRYPTION_KEY")]
end

subgraph AUD["9 - AUDIT TRAIL AND OBSERVABILITY"]
  direction LR
  AU1>"log_audit_event() to audit_events<br/>CREATED, ANALYSIS, AI_ANALYSIS_DEGRADED,<br/>STAGE_ADVANCED, OVERRIDE_APPLIED,<br/>MANAGER_*, COMMITTEE_*, ASSESSMENT_CLOSED"]
  AU2>"workflow_transitions<br/>from / to status, actor, reason"]
  AU3>"Override ledger<br/>AI value vs human value + reason"]
  AU4>"AI usage log<br/>model, tokens, cost, latency, outcome"]
  AU5>"Frozen decision records<br/>and vote history"]
  AU6>"AdminAudit middleware,<br/>ACCESS_DENIED, request timing"]
  AU7>"Langfuse tracing - optional,<br/>not configured in backend/.env"]
  AU8["GET /audit, /audit/all, /audit-export,<br/>/explain - retention and legal holds<br/>on provisional policy"]
end

