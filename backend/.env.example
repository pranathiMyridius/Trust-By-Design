# Copy to backend/.env and fill in. Never commit real values -- .env is
# git-ignored. In production, inject these from a secrets manager.

# --- Database ---------------------------------------------------------------
# SQLite (default) or Postgres. For Postgres in production add
# ?sslmode=require so database traffic is encrypted in transit.
DATABASE_URL=sqlite:///./risk.db

# --- Migration safety guard (app/migrations.py) -------------------------------
# Importing the app never touches the database. On start-up a LOCAL database
# (SQLite, Postgres on localhost) is migrated automatically; a REMOTE one is
# migrated only when this names its exact host -- otherwise the server refuses
# to start against an out-of-date schema. Leave it unset except for a
# deliberate, approved migration run.
MIGRATION_AUTHORIZED_HOST=
# Hosts that also need MIGRATION_ALLOW_PROTECTED_HOST=true (a second step),
# e.g. the primary/production Neon endpoint. Comma-separated host names.
PROTECTED_DATABASE_HOSTS=
MIGRATION_ALLOW_PROTECTED_HOST=false
# --- P3 governance policy (PENDING GOVERNANCE APPROVAL) ------------------------
# Optional JSON file overriding the provisional defaults in
# app/governance/policy.py (approver tiers, role matrix, thresholds). Top-level
# keys replace the default for that key. Unset = provisional defaults.
GOVERNANCE_POLICY_FILE=
# Retired in P3: Admins act as committee members only through an approved,
# declared SoD dual-role exception. Setting this no longer grants anything.
# COMMITTEE_ADMIN_AUTHORITY=

# An ISOLATED staging branch (never the primary), used only by
# scripts/validate_staging_migration.py to rehearse migrations.
STAGING_DATABASE_URL=

# Neon API key for operations scripts only (branching, recovery points,
# rehearsal branches). The application itself never reads it. Prefer a
# user-level environment variable over this file; never commit a value.
# Behind a TLS-inspecting proxy, the scripts verify through the OS trust
# store (truststore); verification is never disabled.
# NEON_API_KEY=

# --- Security (Stage 19) ------------------------------------------------------
# Signing key for login sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Encrypts uploaded evidence files at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: files encrypted with a lost key cannot be recovered.
# It also encrypts application backups (the database copy).
FILE_ENCRYPTION_KEY=
# Key rotation only: the old key(s), comma-separated, kept for reading
# while scripts/rotate_file_encryption_key.py re-encrypts existing files
# under the new FILE_ENCRYPTION_KEY. Leave empty otherwise.
FILE_ENCRYPTION_PREVIOUS_KEYS=

# First admin account on an empty database. If no password is given, a
# random one-time password is printed to the server console.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176,http://127.0.0.1:5176

# true behind a TLS-terminating proxy (or with uvicorn --ssl-keyfile/--ssl-certfile):
# redirects HTTP to HTTPS and sends HSTS.
FORCE_HTTPS=false

# P7: set to "production" for a real deployment. The app then refuses to
# start unless JWT_SECRET (>= 32 chars), a valid FILE_ENCRYPTION_KEY,
# FORCE_HTTPS=true and a TLS database connection are all configured.
APP_ENV=development
# A remote Postgres DATABASE_URL must require TLS (?sslmode=require or
# verify-full) or the app won't start. Only for a non-production setup that
# truly can't use TLS, set this to true; it is refused when APP_ENV=production.
# DATABASE_ALLOW_INSECURE_TRANSPORT=

# Mask card numbers, IBANs, e-mails, phone numbers and national IDs before
# sending content to the external AI provider.
AI_MASK_SENSITIVE_DATA=true

# --- AI provider (app/ai/provider.py) ---------------------------------------------
# openai or openrouter. Default: openai when OPENAI_API_KEY is set.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Chat model. Every AI call sets a temperature and JSON mode, so use a
# non-reasoning chat model (gpt-4.1-mini, gpt-4.1, gpt-4o-mini).
OPENAI_MODEL=gpt-4.1-mini
# 1536 dimensions, the width of document_embeddings.embedding.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Alternative provider:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Seconds to wait for each AI reply (default 120); applies to either provider.
OPENROUTER_TIMEOUT_SECONDS=120

# --- Performance targets (Stage 19), milliseconds ------------------------------------
PAGE_LOAD_TARGET_MS=2000
RISK_CALC_TARGET_MS=3000
SUBMIT_TARGET_MS=5000
MAX_UPLOAD_MB=50
PROCESSING_MAX_WORKERS=2
PROCESSING_MAX_ATTEMPTS=5

# --- Backup and recovery (Stage 19) ----------------------------------------------
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
RECOVERY_POINT_OBJECTIVE_HOURS=24
RECOVERY_TIME_OBJECTIVE_HOURS=4

# --- Workflow ------------------------------------------------------------------
WORKFLOW_ESCALATION_INTERVAL_SECONDS=900

# --- Observability: Langfuse (optional) ---------------------------------------
# Traces every risk-assessment workflow run, each LangGraph node and every
# LLM call (model, latency, tokens, cost, errors). Leave the keys empty to
# disable -- the app works exactly the same without Langfuse. No prompt or
# reply text is sent unless LANGFUSE_CAPTURE_CONTENT=true (and even then
# it is masked first, see AI_MASK_SENSITIVE_DATA). API keys are never sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# e.g. https://cloud.langfuse.com, https://us.cloud.langfuse.com or self-hosted
LANGFUSE_HOST=
LANGFUSE_ENABLED=true
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENVIRONMENT=local

# --- AI evaluations (backend/tests/evals; not used by the running app) -------
# Judge model for DeepEval metrics. Prefer a stronger model than the one
# under test -- a model grading its own output is a biased judge.
EVAL_JUDGE_MODEL=
# Optional: comma-separated case ids, repeated runs for consistency, retries.
EVAL_CASES=
EVAL_RUNS=1
EVAL_MAX_ATTEMPTS=3
EVAL_BACKOFF_SECONDS=5
